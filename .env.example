# =============================================================================
# GitHub OAuth Configuration
# =============================================================================
# 创建 GitHub OAuth App: https://github.com/settings/developers
# Homepage URL: http://localhost:3000
# Callback URL: http://localhost:3000/api/auth/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/callback

# =============================================================================
# AI Model Configuration (OpenRouter)
# =============================================================================
# 获取 API Key: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=your_openrouter_api_key

# 可用模型 (参考): https://openrouter.ai/models
# 示例模型:
# - openai/gpt-4o
# - openai/gpt-4o-mini
# - anthropic/claude-3.5-sonnet
# - google/gemini-2.0-flash-exp
DEFAULT_MODEL=openai/gpt-4o-mini

# =============================================================================
# Mastra Configuration
# =============================================================================
# Mastra 使用 OpenRouter 作为模型提供商
# 无需额外配置，Mastra 会读取 OPENROUTER_API_KEY 环境变量

# =============================================================================
# Application Configuration
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
