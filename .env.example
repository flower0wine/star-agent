# =============================================================================
# AI Provider Configuration
# =============================================================================
# 选择 AI 提供商: "openai" (默认) 或 "nvidia"
AI_PROVIDER=nvidia

# =============================================================================
# OpenAI Configuration
# =============================================================================
# 获取 API Key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# 可用模型: gpt-4o-mini, gpt-4o, gpt-4-turbo
OPENAI_MODEL=gpt-4o-mini

# =============================================================================
# NVIDIA NIM Configuration
# =============================================================================
# 注册并获取 API Key: https://build.nvidia.com/
# 获取免费积分: 新用户获得 1000 inference credits
NIM_API_KEY=your_nvidia_api_key

# 可用模型 (参考): https://build.nvidia.com/explore/discover
# 示例模型:
# - deepseek-ai/deepseek-r1
# - nvidia/llama-3.1-nemotron-70b-instruct
# - meta/llama-3.3-70b-instruct
NIM_MODEL=minimaxai/minimax-m2.5

# 可选: 自定义 API 端点 (默认为 NVIDIA NIM)
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# =============================================================================
# Patent Providers (Optional)
# =============================================================================
# SerpApi key fallback for Patent Agent (when not set in Agent settings)
SERPAPI_API_KEY=your_serpapi_api_key

# =============================================================================
# Observability (Langfuse + AI SDK Telemetry)
# =============================================================================
# 可选: langfuse | none
OBSERVABILITY_PROVIDER=langfuse
OBSERVABILITY_ENV=development
OBSERVABILITY_SAMPLE_RATE=1
OBSERVABILITY_RECORD_INPUTS=false
OBSERVABILITY_RECORD_OUTPUTS=false

# Langfuse 配置
LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxx
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# =============================================================================
# Application Configuration
# =============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
